<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<springProfile name="dev">
		<property name="LOG_LEVEL" value="DEBUG"/>
		<property name="LOG_FILE" value="logs/food-delivery-dev.log"/>
	</springProfile>

	<springProfile name="prod">
		<property name="LOG_LEVEL" value="INFO"/>
		<property name="LOG_FILE" value="logs/food-delivery-prod.log"/>
	</springProfile>

	<springProfile name="!dev &amp; !prod">
		<property name="LOG_LEVEL" value="INFO"/>
		<property name="LOG_FILE" value="logs/food-delivery.log"/>
	</springProfile>

	<property name="LOG_PATTERN"
			  value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{correlationId:-NO-CORR-ID}] %-5level %logger{36} - %msg%n"/>

	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>${LOG_PATTERN}</pattern>
		</encoder>
	</appender>

	<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_FILE}</file>
		<encoder>
			<pattern>${LOG_PATTERN}</pattern>
		</encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
			<maxFileSize>10MB</maxFileSize>
			<maxHistory>30</maxHistory>
			<totalSizeCap>1GB</totalSizeCap>
		</rollingPolicy>
	</appender>

	<appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
		<http>
			<url>${loki.url:-http://localhost:3100/loki/api/v1/push}</url>
		</http>
		<format>
			<label>
				<pattern>app=${spring.application.name:-food-delivery},env=${spring.profiles.active:-default}</pattern>
			</label>
			<message>
				<pattern>${LOG_PATTERN}</pattern>
			</message>
		</format>
		<batch>
			<timeoutMs>5000</timeoutMs>
			<maxBytes>4000000</maxBytes>
		</batch>
	</appender>

	<root level="${LOG_LEVEL}">
		<appender-ref ref="CONSOLE"/>
		<appender-ref ref="FILE"/>
		<appender-ref ref="LOKI"/>
	</root>

	<logger name="com.ait" level="${LOG_LEVEL}"/>
	<logger name="org.springframework.web" level="INFO"/>
	<logger name="org.hibernate.SQL" level="DEBUG"/>
	<logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE"/>
</configuration>
